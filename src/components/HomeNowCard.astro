---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n/ui';
import { formatDate, firstParagraph } from '../lib/format';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const entries = await getCollection('now', ({ id }) => id.startsWith(`${locale}/`));
const [latest] = [...entries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<article class="home-card card now-card">
  <div class="card-head">
    <h3>{t(locale, 'home.now.title')}</h3>
    {latest && <span class="date">{formatDate(latest.data.date, locale, 'medium')}</span>}
  </div>
  {latest && <p class="summary">{firstParagraph(latest.body)}</p>}
  <a class="more" href={getRelativeLocaleUrl(locale, '/now/')}>{t(locale, 'home.now.more')}</a>
</article>

<style>
  .home-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px 32px;
    color: var(--ink);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  h3 {
    margin: 0;
    font-size: 24px;
  }

  .date {
    font-size: 13px;
    color: var(--muted);
  }

  .summary {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }

  .more {
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-ink);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 767.98px) {
    .home-card {
      gap: 14px;
      padding: 22px 24px;
    }

    h3 {
      font-size: 21px;
    }

    .date {
      font-size: 12px;
    }

    .summary {
      padding-top: 14px;
      font-size: 15px;
    }
  }
</style>
