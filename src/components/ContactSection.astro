---
import { contactLinks, contactLinkUrl, contactEmail, type ContactPlatform } from '../config/site';

const initials: Record<ContactPlatform, string> = {
  linkedin: 'in',
  github: 'gh',
  youtube: '▶',
};

const platformLabels: Record<ContactPlatform, string> = {
  linkedin: 'LinkedIn',
  github: 'GitHub',
  youtube: 'YouTube',
};

const locale = Astro.currentLocale ?? 'en';

const introCopy = {
  en: "[PLACEHOLDER: I'd love to hear from you — whether it's about a project, an opportunity, or just to say hello. Here's how to reach me.]",
  es: '[MARCADOR DE POSICIÓN: Me encantaría saber de ti — ya sea por un proyecto, una oportunidad o solo para saludar. Así puedes encontrarme.]',
} as const;

const intro = introCopy[locale as 'en' | 'es'] ?? introCopy.en;
// FR-017 pins this button's label to the literal word "email" in both
// languages (not translated), same as the platform names below it.
---

<section id="contact" class="contact">
  <p class="intro">{intro}</p>
  <ul class="links">
    {
      contactLinks.map((link) => (
        <li>
          <a
            class="icon-link"
            href={contactLinkUrl(link)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={platformLabels[link.platform]}
          >
            <span class="icon" aria-hidden="true">
              {initials[link.platform]}
            </span>
            <span class="platform-label">{platformLabels[link.platform]}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a class="email-button" href={`mailto:${contactEmail}`}>email</a>
</section>

<style>
  .contact {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .intro {
    max-width: 640px;
    margin: 0 auto 2rem;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .icon-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary-blue);
    color: var(--color-white);
    font-weight: 700;
    font-size: 1.1rem;
  }

  /* White text on primary-green is ~2.6:1 contrast, below WCAG AA's 4.5:1 for
     normal text — dark text on the green passes (~6.8:1); primary-blue's
     background already passes with white text (~6.9:1). SC-008. */
  .icon-link:hover .icon {
    background: var(--color-primary-green);
    color: var(--color-neutral-900);
  }

  .platform-label {
    font-size: 0.85rem;
  }

  .email-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-primary-green);
    color: var(--color-neutral-900);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 700;
  }

  .email-button:hover {
    background: var(--color-primary-blue);
    color: var(--color-white);
  }
</style>
