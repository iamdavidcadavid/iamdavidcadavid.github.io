---
// Shared empty-state card (design README: "a centred surface card with a CSS-shape illustration
// in --blue"). Used when an album, the Photos list, Now or the Sales catalogue has no content.

interface Props {
  /** Already localized by the caller (from ui.ts). */
  message: string;
  illustration: 'camera' | 'hourglass' | 'tag';
}

const { message, illustration } = Astro.props;
---

<div class="empty-state card anim-rise delay-1" role="status">
  {
    illustration === 'camera' && (
      <div class="art camera" aria-hidden="true">
        <span class="camera-top" />
        <span class="camera-body" />
        <span class="camera-flash" />
        <span class="camera-lens">
          <span class="camera-iris" />
        </span>
      </div>
    )
  }
  {
    illustration === 'hourglass' && (
      <div class="art hourglass" aria-hidden="true">
        <span class="hg-cap hg-cap-top" />
        <span class="hg-glass hg-glass-top" />
        <span class="hg-glass hg-glass-bottom" />
        <span class="hg-sand-top" />
        <span class="hg-sand-bottom" />
        <span class="hg-drop" />
        <span class="hg-cap hg-cap-bottom" />
      </div>
    )
  }
  {
    illustration === 'tag' && (
      <div class="art tag" aria-hidden="true">
        <span class="tag-swing">
          <span class="tag-body" />
          <span class="tag-hole" />
          <span class="tag-line tag-line-1" />
          <span class="tag-line tag-line-2" />
        </span>
      </div>
    )
  }
  <p class="empty-message">{message}</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: clamp(44px, 6vw, 77px) 24px;
    text-align: center;
  }

  .empty-message {
    margin: 0;
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.3;
    color: var(--ink);
  }

  .art {
    position: relative;
  }

  .art span {
    position: absolute;
    display: block;
  }

  /* Camera (album and Photos list) */
  .camera {
    width: 190px;
    height: 140px;
  }

  .camera-top {
    left: 34px;
    top: 0;
    width: 52px;
    height: 22px;
    border-radius: 10px 10px 0 0;
    background: var(--blue);
  }

  .camera-body {
    left: 0;
    top: 16px;
    width: 190px;
    height: 124px;
    border-radius: 24px;
    background: var(--blue);
  }

  .camera-flash {
    right: 20px;
    top: 30px;
    width: 16px;
    height: 8px;
    border-radius: 4px;
    background: var(--on-blue);
    opacity: 0.7;
  }

  .camera-lens {
    left: 55px;
    top: 38px;
    display: grid !important;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--lens);
    box-shadow: 0 0 0 6px var(--lens-ring);
  }

  .camera .camera-iris {
    position: static;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--blue-soft);
  }

  /* Hourglass (Now) */
  .hourglass {
    width: 120px;
    height: 150px;
  }

  .hg-cap {
    left: 0;
    width: 120px;
    height: 14px;
    border-radius: 7px;
    background: var(--blue);
  }

  .hg-cap-top {
    top: 0;
  }

  .hg-cap-bottom {
    bottom: 0;
  }

  .hg-glass {
    left: 14px;
    width: 92px;
    height: 61px;
    background: var(--blue-soft);
  }

  .hg-glass-top {
    top: 14px;
    clip-path: polygon(0 0, 100% 0, 56% 100%, 44% 100%);
  }

  .hg-glass-bottom {
    top: 75px;
    clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%);
  }

  .hg-sand-top {
    left: 34px;
    top: 45px;
    width: 52px;
    height: 30px;
    background: var(--blue);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .hg-sand-bottom {
    left: 26px;
    top: 112px;
    width: 68px;
    height: 24px;
    background: var(--blue);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .hg-drop {
    left: 57px;
    top: 84px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
  }

  /* Price tag (Sales) */
  .tag {
    width: 190px;
    height: 120px;
  }

  .tag .tag-swing {
    inset: 0;
    transform-origin: 44px 60px;
  }

  .tag-body {
    left: 10px;
    top: 15px;
    width: 170px;
    height: 90px;
    border-radius: 16px;
    background: var(--blue);
    clip-path: polygon(0 50%, 22% 0, 100% 0, 100% 100%, 22% 100%);
  }

  .tag-hole {
    left: 37px;
    top: 53px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--on-blue);
  }

  .tag-line {
    left: 72px;
    height: 10px;
    border-radius: 5px;
    background: var(--on-blue);
    opacity: 0.7;
  }

  .tag-line-1 {
    top: 43px;
    width: 84px;
  }

  .tag-line-2 {
    top: 67px;
    width: 56px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .camera .camera-iris {
      animation: glow 1.8s ease-in-out infinite;
    }

    .hg-drop {
      animation: pulse 1.4s ease-in-out infinite;
    }

    .tag .tag-swing {
      animation: wobble 2.4s ease-in-out infinite;
    }
  }
</style>
