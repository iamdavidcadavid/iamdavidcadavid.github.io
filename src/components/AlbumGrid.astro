---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { plural } from '../i18n/ui';

interface Props {
  albums: CollectionEntry<'albums'>[];
  locale: 'en' | 'es';
}

const { albums, locale } = Astro.props;

function slugFor(id: string): string {
  return id.split('/').slice(1).join('/');
}

const items = albums.map((album) => ({
  href: `${getRelativeLocaleUrl(locale, '/photos/')}${slugFor(album.id)}/`,
  title: album.data.title,
  cover: album.data.cover,
  count: plural(locale, 'photos.count', album.data.photos.length),
}));
---

<ul class="album-grid anim-rise delay-1">
  {
    items.map((item) => (
      <li>
        <a class="album-card card" href={item.href}>
          <img src={item.cover.src} alt={item.cover.alt} loading="lazy" />
          <span class="info">
            <span class="title">{item.title}</span>
            <span class="count">{item.count}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .album-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 12px;
    border-radius: 28px;
    color: var(--ink);
    text-decoration: none;
  }

  .album-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 20px;
  }

  .info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 0 10px 8px;
  }

  .title {
    font-family: var(--font-serif), Georgia, serif;
    font-size: 22px;
    line-height: 1.25;
  }

  .count {
    flex: none;
    font-size: 14px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .album-card {
      transition: transform 0.25s;
    }

    .album-card:hover {
      transform: translateY(-4px);
    }
  }
</style>
