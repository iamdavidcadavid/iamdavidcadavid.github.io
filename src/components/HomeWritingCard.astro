---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n/ui';
import { formatDate } from '../lib/format';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const posts = await getCollection('blog', ({ id }) => id.startsWith(`${locale}/`));
const latest = [...posts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    href: `${getRelativeLocaleUrl(locale, '/blog/')}${post.id.split('/').slice(1).join('/')}/`,
    title: post.data.title,
    date: formatDate(post.data.pubDate, locale, 'short'),
    pending: post.data.translationPending,
  }));
---

<article class="home-card card writing-card">
  <div class="card-head">
    <h3>{t(locale, 'home.writing.title')}</h3>
    <a class="more" href={getRelativeLocaleUrl(locale, '/blog/')}>{t(locale, 'home.writing.all')}</a>
  </div>
  {
    latest.length === 0 ? (
      <p class="empty">{t(locale, 'blog.empty')}</p>
    ) : (
      <ul>
        {latest.map((post) => (
          <li>
            <a class="row" href={post.href}>
              <span class="date">{post.date}</span>
              <span class="title">
                {post.title}
                {post.pending && <span class="pill">{t(locale, 'pill.enOnly')}</span>}
              </span>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .home-card {
    display: flex;
    flex-direction: column;
    padding: 28px 32px;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }

  h3 {
    margin: 0;
    font-size: 24px;
  }

  .more {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 16px;
    gap: 12px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .row:hover {
    color: var(--blue-ink);
  }

  .date {
    font-size: 13px;
    color: var(--muted);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-size: 16px;
    line-height: 1.35;
  }

  .pill {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11px;
    color: var(--muted);
  }

  .arrow {
    color: var(--faint);
  }

  .empty {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 767.98px) {
    .home-card {
      padding: 22px 24px 8px;
    }

    .card-head {
      margin-bottom: 10px;
    }

    h3 {
      font-size: 21px;
    }

    .row {
      grid-template-columns: 54px minmax(0, 1fr) 14px;
      gap: 10px;
      padding: 16px 0;
    }

    .date {
      font-size: 12px;
    }

    .title {
      font-size: 15px;
    }
  }
</style>
