---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitch from './LanguageSwitch.astro';
import { t, type UIKey } from '../i18n/ui';

interface Props {
  hideLanguageSwitch?: boolean;
}

const { hideLanguageSwitch = false } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

const sections: { segment: string; key: UIKey; path: string }[] = [
  { segment: '', key: 'nav.home', path: '/' },
  { segment: 'now', key: 'nav.now', path: '/now/' },
  { segment: 'contact', key: 'nav.contact', path: '/contact/' },
  { segment: 'blog', key: 'nav.blog', path: '/blog/' },
  { segment: 'photos', key: 'nav.photos', path: '/photos/' },
];

// Locale-agnostic first path segment decides the active item; pages outside the nav
// (sales, easter-egg, 404) match nothing (routing-contract.md).
let path = Astro.url.pathname;
if (path === '/es' || path.startsWith('/es/')) path = path.slice(3);
const firstSegment = path.split('/').filter(Boolean)[0] ?? '';

const links = sections.map((section) => ({
  label: t(locale, section.key),
  href: getRelativeLocaleUrl(locale, section.path),
  active: section.segment === firstSegment,
}));
---

<div class="navbar">
  <nav class="desktop-nav">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <details class="mobile-menu" data-mobile-menu>
    <summary aria-label={t(locale, 'nav.menuToggle')}>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </summary>
    <nav class="menu-card">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                {link.label}
                <span class="dot" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
      {
        !hideLanguageSwitch && (
          <div class="menu-lang">
            <LanguageSwitch large />
          </div>
        )
      }
    </nav>
  </details>
</div>

<script>
  // Enhancements only: the <details> menu already opens and closes without JS.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const summary = menu?.querySelector('summary');

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      summary?.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.open = false;
    });
  });
</script>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  /* Desktop: centred pill */
  .desktop-nav ul {
    display: flex;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-pill);
    font-size: 15px;
  }

  .desktop-nav a {
    display: block;
    padding: 10px 18px;
    border-radius: 999px;
    color: var(--ink);
  }

  .desktop-nav a:hover {
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .desktop-nav a[aria-current='page'] {
    background: var(--blue);
    color: var(--on-blue);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 767.98px) {
    .navbar {
      order: 3;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      cursor: pointer;
      list-style: none;
      border-radius: 50%;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 2px;
    }

    .bars {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .bars span {
      display: block;
      width: 20px;
      height: 2px;
      border-radius: 2px;
      background: var(--ink);
    }

    /* Positioned against the sticky .site-header, so it spans the header's full width
       and stays attached while scrolling. */
    .menu-card {
      position: absolute;
      top: 68px;
      left: 12px;
      right: 12px;
      z-index: 50;
      padding: 8px 20px 20px;
      border-radius: 24px;
      background: var(--surface);
      box-shadow: var(--shadow-menu);
    }

    .menu-card a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-serif), Georgia, serif;
      font-size: 24px;
      color: var(--ink);
    }

    .menu-card a[aria-current='page'] {
      color: var(--blue-ink);
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .menu-card a[aria-current='page'] .dot {
      background: var(--blue);
    }

    .menu-lang {
      padding-top: 18px;
    }
  }

  @media (max-width: 767.98px) and (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] .menu-card {
      animation: fade 0.2s ease-out;
    }
  }
</style>
