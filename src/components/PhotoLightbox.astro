---
import { t } from '../i18n/ui';

interface Photo {
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
  locale: 'en' | 'es';
}

const { photos, locale } = Astro.props;

const emptyMessage = locale === 'en' ? 'Development in process…' : 'En proceso de revelado…';
---

{
  photos.length === 0 ? (
    <div class="empty-state card anim-rise delay-1" role="status">
      <div class="camera" aria-hidden="true">
        <span class="camera-top" />
        <span class="camera-body" />
        <span class="camera-flash" />
        <span class="camera-lens">
          <span class="camera-iris" />
        </span>
      </div>
      <p class="empty-message">{emptyMessage}</p>
    </div>
  ) : (
    <>
      <ul class="photo-list anim-rise delay-1" data-photo-list>
        {photos.map((photo, index) => (
          <li>
            <button type="button" class="photo-thumb" data-photo-trigger data-index={index}>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>

      <div class="modal" data-modal hidden>
        <button type="button" class="modal-backdrop" data-modal-close aria-label={t(locale, 'viewer.close')} />
        <div class="modal-content">
          <button type="button" class="modal-close" data-modal-close aria-label={t(locale, 'viewer.close')}>
            ×
          </button>
          {photos.length > 1 && (
            <button type="button" class="modal-nav" data-modal-prev aria-label={t(locale, 'viewer.prev')}>
              ‹
            </button>
          )}
          <img data-modal-image src="" alt="" />
          {photos.length > 1 && (
            <button type="button" class="modal-nav" data-modal-next aria-label={t(locale, 'viewer.next')}>
              ›
            </button>
          )}
        </div>
      </div>
    </>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-list]').forEach((list) => {
    const wrapper = list.parentElement;
    const modal = wrapper?.querySelector<HTMLElement>('[data-modal]');
    const modalImage = modal?.querySelector<HTMLImageElement>('[data-modal-image]');
    const modalCloseButton = modal?.querySelector<HTMLButtonElement>('.modal-close');
    const modalPrevButton = modal?.querySelector<HTMLButtonElement>('[data-modal-prev]');
    const modalNextButton = modal?.querySelector<HTMLButtonElement>('[data-modal-next]');
    const triggers = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-photo-trigger]'));
    const photos = triggers.map((t) => t.querySelector('img'));
    let lastFocused: Element | null = null;
    let currentIndex = 0;

    function showAt(index: number) {
      const wrapped = ((index % photos.length) + photos.length) % photos.length;
      const img = photos[wrapped];
      if (!img || !modalImage) return;
      modalImage.src = img.src;
      modalImage.alt = img.alt;
      currentIndex = wrapped;
    }

    function open(index: number) {
      if (!modal || !modalImage) return;
      lastFocused = document.activeElement;
      showAt(index);
      modal.hidden = false;
      modalCloseButton?.focus();
    }

    function close() {
      if (modal) modal.hidden = true;
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => open(index));
    });

    modal?.querySelectorAll('[data-modal-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    modalPrevButton?.addEventListener('click', () => showAt(currentIndex - 1));
    modalNextButton?.addEventListener('click', () => showAt(currentIndex + 1));

    document.addEventListener('keydown', (event) => {
      if (!modal || modal.hidden) return;
      if (event.key === 'Escape') {
        close();
      } else if (photos.length > 1 && event.key === 'ArrowLeft') {
        showAt(currentIndex - 1);
      } else if (photos.length > 1 && event.key === 'ArrowRight') {
        showAt(currentIndex + 1);
      }
    });
  });
</script>

<style>
  .photo-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: clamp(10px, 1.2vw, 15px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 20px;
    overflow: hidden;
    background: none;
    cursor: zoom-in;
  }

  .photo-thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .photo-thumb:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo-thumb img {
      transition:
        transform 0.25s,
        filter 0.25s;
    }

    .photo-thumb:hover img {
      transform: scale(1.02);
      filter: brightness(1.05);
    }
  }

  .modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  /* The [hidden] attribute alone loses to the class selector's specificity
     above, so it would otherwise show the modal at all times. */
  .modal[hidden] {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--backdrop);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  /* One row: previous arrow, photo, next arrow. The photo is the tallest item, so
     align-items: center keeps both arrows on its vertical middle at any photo size. */
  .modal-content {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .modal-content img {
    min-width: 0;
    max-width: min(760px, calc(100vw - 2 * (44px + 14px) - 32px));
    max-height: 72vh;
    object-fit: contain;
    border-radius: 14px;
  }

  .modal-nav {
    flex: none;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: var(--blue);
    color: var(--on-blue);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .modal-nav:hover {
    background: var(--blue-hover);
  }

  .modal-close {
    position: absolute;
    top: -48px;
    right: 0;
    width: 44px;
    height: 44px;
    border: none;
    background: none;
    color: var(--on-backdrop);
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }

  .modal-nav:focus-visible,
  .modal-close:focus-visible {
    outline: 2px solid var(--on-backdrop);
    outline-offset: 2px;
  }

  @media (max-width: 767.98px) {
    .modal-content {
      gap: 10px;
    }

    .modal-content img {
      max-width: min(760px, calc(100vw - 2 * (44px + 10px) - 24px));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal:not([hidden]) {
      animation: fade 0.25s ease-out;
    }
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: clamp(44px, 6vw, 77px) 24px;
    text-align: center;
  }

  .empty-message {
    margin: 0;
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.3;
    color: var(--ink);
  }

  .camera {
    position: relative;
    width: 190px;
    height: 140px;
  }

  .camera > span {
    position: absolute;
    display: block;
  }

  .camera-top {
    left: 34px;
    top: 0;
    width: 52px;
    height: 22px;
    border-radius: 10px 10px 0 0;
    background: var(--blue);
  }

  .camera-body {
    left: 0;
    top: 16px;
    width: 190px;
    height: 124px;
    border-radius: 24px;
    background: var(--blue);
  }

  .camera-flash {
    right: 20px;
    top: 30px;
    width: 16px;
    height: 8px;
    border-radius: 4px;
    background: var(--on-blue);
    opacity: 0.7;
  }

  .camera-lens {
    left: 55px;
    top: 38px;
    display: grid !important;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--lens);
    box-shadow: 0 0 0 6px var(--lens-ring);
  }

  .camera-iris {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--blue-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .camera-iris {
      animation: glow 1.8s ease-in-out infinite;
    }
  }
</style>
