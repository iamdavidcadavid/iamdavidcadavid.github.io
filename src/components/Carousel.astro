---
interface Photo {
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
  itemId: string;
}

const { photos, itemId } = Astro.props;
---

<div class="carousel" data-carousel data-item-id={itemId}>
  <div class="carousel-track">
    {
      photos.map((photo, index) => (
        <button
          type="button"
          class="carousel-slide"
          data-slide
          data-index={index}
          style={index === 0 ? undefined : 'display:none'}
          aria-label="Enlarge photo"
        >
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </button>
      ))
    }
  </div>
  {
    photos.length > 1 && (
      <div class="carousel-controls">
        <button type="button" data-carousel-prev aria-label="Previous photo">
          ‹
        </button>
        <button type="button" data-carousel-next aria-label="Next photo">
          ›
        </button>
      </div>
    )
  }

  <div class="modal" data-carousel-modal hidden>
    <button type="button" class="modal-backdrop" data-modal-close aria-label="Close" />
    <div class="modal-content">
      <button type="button" class="modal-close" data-modal-close aria-label="Close">
        ×
      </button>
      <img data-modal-image src="" alt="" />
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const modal = carousel.querySelector<HTMLElement>('[data-carousel-modal]');
    const modalImage = modal?.querySelector<HTMLImageElement>('[data-modal-image]');
    let current = 0;

    function show(index: number) {
      slides.forEach((slide, i) => {
        slide.style.display = i === index ? '' : 'none';
      });
      current = index;
    }

    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => {
      show((current - 1 + slides.length) % slides.length);
    });
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
      show((current + 1) % slides.length);
    });

    const modalCloseButton = modal?.querySelector<HTMLButtonElement>('.modal-close');
    let lastFocused: Element | null = null;

    function closeModal() {
      if (modal) modal.hidden = true;
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    slides.forEach((slide, index) => {
      slide.addEventListener('click', () => {
        const img = slide.querySelector('img');
        if (!img || !modal || !modalImage) return;
        lastFocused = document.activeElement;
        modalImage.src = img.src;
        modalImage.alt = img.alt;
        modal.hidden = false;
        modalCloseButton?.focus();
      });
    });

    modal?.querySelectorAll('[data-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
    });
  });
</script>

<style>
  .carousel {
    position: relative;
    max-width: 320px;
  }

  .carousel-slide {
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    width: 100%;
  }

  .carousel-slide img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .carousel-controls {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .carousel-controls button {
    background: var(--color-primary-blue);
    color: var(--color-white);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  /* The [hidden] attribute alone loses to the class selector's specificity
     above, so it would otherwise show the modal at all times. */
  .modal[hidden] {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
  }

  .modal-content img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 8px;
  }

  .modal-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: var(--color-white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
