---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { blogPageSize } from '../config/site';
import { excerptFor, formatDate } from '../lib/format';
import { t } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: 'en' | 'es';
}

const { posts, locale } = Astro.props;

function slugFor(id: string): string {
  // ids are locale-prefixed, e.g. "en/welcome-to-the-blog" -> "welcome-to-the-blog"
  const parts = id.split('/');
  return parts.slice(1).join('/');
}


const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const items = sorted.map((post) => ({
  href: `${getRelativeLocaleUrl(locale, '/blog/')}${slugFor(post.id)}/`,
  title: post.data.title,
  excerpt: excerptFor(post.body),
  date: formatDate(post.data.pubDate, locale, 'long'),
  translationPending: post.data.translationPending,
}));

const otherLanguageNote = locale === 'en' ? 'Not yet available in Spanish' : 'No disponible aún en inglés';
const loadMoreLabel = locale === 'en' ? 'Load more' : 'Cargar más';
---

{
  items.length === 0 ? (
    <div class="empty-state card anim-rise delay-1" role="status">
      <div class="oven" aria-hidden="true">
        <span class="oven-body" />
        <span class="oven-knob knob-1" />
        <span class="oven-knob knob-2" />
        <span class="oven-window">
          <span class="oven-glow" />
        </span>
        <span class="oven-base" />
      </div>
      <p class="empty-message">{t(locale, 'blog.empty')}</p>
    </div>
  ) : (
    <>
      <ul class="blog-list card anim-rise delay-1" data-blog-list data-page-size={blogPageSize}>
        {items.map((item, index) => (
          <li class="blog-item" data-index={index}>
            <a class="row" href={item.href}>
              <span class="date">{item.date}</span>
              <span class="main">
                <span class="title-line">
                  <span class="title">{item.title}</span>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </span>
                {item.translationPending && <span class="pending-note">{otherLanguageNote}</span>}
                <span class="excerpt">{item.excerpt}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="btn btn-blue load-more" data-load-more>
        {loadMoreLabel}
      </button>
    </>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-blog-list]').forEach((list) => {
    const pageSize = Number(list.dataset.pageSize ?? '5');
    const items = Array.from(list.querySelectorAll<HTMLElement>('.blog-item'));
    const button = list.parentElement?.querySelector<HTMLButtonElement>('[data-load-more]');
    let shown = 0;

    function reveal() {
      const next = Math.min(shown + pageSize, items.length);
      for (let i = shown; i < next; i++) {
        items[i].style.display = '';
      }
      shown = next;
      if (button) {
        button.style.display = shown >= items.length ? 'none' : '';
      }
    }

    items.forEach((item) => {
      item.style.display = 'none';
    });
    reveal();

    button?.addEventListener('click', reveal);
  });
</script>

<style>
  .blog-list {
    list-style: none;
    margin: 0;
    padding: clamp(8px, 1vw, 13px) clamp(22px, 3vw, 38px);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 32px;
    padding: clamp(20px, 2.2vw, 28px) 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .blog-item:first-child .row {
    border-top: 0;
  }

  .row:hover {
    color: var(--blue-ink);
  }

  .date {
    flex: 0 0 150px;
    padding-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  .main {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .title-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .title {
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.25;
  }

  .arrow {
    color: var(--faint);
  }

  .pending-note {
    align-self: flex-start;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
  }

  .excerpt {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .load-more {
    display: flex;
    width: fit-content;
    margin: 28px auto 0;
    padding: 15px 30px;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: clamp(44px, 6vw, 77px) 24px;
    text-align: center;
  }

  .empty-message {
    margin: 0;
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.3;
    color: var(--ink);
  }

  .oven {
    position: relative;
    width: 200px;
    height: 150px;
  }

  .oven > span {
    position: absolute;
    display: block;
  }

  .oven-body {
    left: 0;
    top: 0;
    width: 200px;
    height: 136px;
    border-radius: 24px;
    background: var(--blue);
  }

  .oven-knob {
    top: 14px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--on-blue);
    opacity: 0.7;
  }

  .knob-1 {
    right: 24px;
  }

  .knob-2 {
    right: 42px;
  }

  .oven-window {
    left: 22px;
    top: 38px;
    display: grid !important;
    place-items: center;
    width: 156px;
    height: 78px;
    border-radius: 14px;
    background: var(--shade);
  }

  .oven-glow {
    display: block;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 28px 6px var(--glow);
  }

  .oven-base {
    left: -8px;
    bottom: 0;
    width: 216px;
    height: 12px;
    border-radius: 6px;
    background: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .oven-glow {
      animation: glow 1.6s ease-in-out infinite;
    }
  }
</style>
