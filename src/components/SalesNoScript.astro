---
interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const message =
  locale === 'en'
    ? 'This page requires JavaScript to be enabled in your browser.'
    : 'Esta página requiere que JavaScript esté habilitado en tu navegador.';
---

<noscript>
  <p class="sg-noscript">{message}</p>
</noscript>

<style is:global>
  .sg-noscript {
    max-width: 480px;
    margin: 3rem auto;
    padding: 1rem 1.5rem;
    text-align: center;
    background: var(--color-neutral-100);
    border-radius: 8px;
    color: var(--color-neutral-900);
  }
</style>
