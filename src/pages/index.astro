---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeNowCard from '../components/HomeNowCard.astro';
import HomeWritingCard from '../components/HomeWritingCard.astro';
import HomePhotosCard from '../components/HomePhotosCard.astro';
---

<BaseLayout title="David Cadavid">
  <HomeHero />
  <section class="home-cards anim-rise delay-4">
    <HomeNowCard locale="en" />
    <HomeWritingCard locale="en" />
    <HomePhotosCard locale="en" />
  </section>
</BaseLayout>

<style>
  .home-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
    padding-top: 56px;
  }


  @media (max-width: 767.98px) {
    .home-cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding-top: 32px;
    }
  }
</style>
