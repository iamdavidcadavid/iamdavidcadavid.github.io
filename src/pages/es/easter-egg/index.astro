---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="🥚" noindex={true}>
  <div class="easter-egg">
    <div class="egg" aria-hidden="true">
      <span class="spot spot-1"></span>
      <span class="spot spot-2"></span>
      <span class="spot spot-3"></span>
    </div>
    <h1 class="anim-rise">¡Encontraste la página secreta<span class="mark">!</span></h1>
    <p class="anim-rise delay-1">[MARCADOR DE POSICIÓN: Aquí irá algo divertido más adelante.]</p>
    <a class="btn btn-surface anim-rise delay-2" href={getRelativeLocaleUrl('es', '/')}>← Volver al inicio</a>
  </div>
</BaseLayout>

<style>
  .easter-egg {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: 640px;
    margin: clamp(16px, 3vw, 38px) auto 0;
    text-align: center;
  }

  .egg {
    position: relative;
    width: 120px;
    height: 150px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--surface);
    box-shadow:
      inset -10px -12px 0 0 var(--sand),
      var(--shadow-egg);
    transform-origin: 50% 90%;
  }

  .spot {
    position: absolute;
    border-radius: 50%;
    background: var(--blue);
  }

  .spot-1 {
    left: 30px;
    top: 40px;
    width: 14px;
    height: 14px;
  }

  .spot-2 {
    left: 70px;
    top: 62px;
    width: 10px;
    height: 10px;
    opacity: 0.7;
  }

  .spot-3 {
    left: 44px;
    top: 92px;
    width: 18px;
    height: 18px;
    opacity: 0.85;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .mark {
    color: var(--blue);
  }

  p {
    margin: 0;
    font-size: clamp(16px, 1.45vw, 19px);
    line-height: 1.7;
    color: var(--muted);
  }

  .btn {
    padding: 14px 26px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .egg {
      animation: wobble 2.4s ease-in-out infinite;
    }
  }
</style>
