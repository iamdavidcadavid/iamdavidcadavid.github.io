---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AlbumGrid from '../../../components/AlbumGrid.astro';
import PageTitle from '../../../components/PageTitle.astro';
import { t, plural } from '../../../i18n/ui';

const albums = await getCollection('albums', ({ id }) => id.startsWith('es/'));
---

<BaseLayout title="Fotos — David Cadavid">
  <PageTitle text={t('es', 'nav.photos')} meta={plural('es', 'photos.albums', albums.length)} />
  <AlbumGrid albums={albums} locale="es" />
</BaseLayout>
