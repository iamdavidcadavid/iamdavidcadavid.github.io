---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id.split('/').slice(1).join('/') },
    props: { post },
  }));
}

const locale = 'en';
const { post } = Astro.props;
const { Content } = await render(post);
const blogUrl = getRelativeLocaleUrl(locale, '/blog/');
---

<BaseLayout title={`${post.data.title} — David Cadavid`} hideLanguageSwitch={post.data.translationPending}>
  <article class="post">
    <header class="anim-slide-left">
      <a class="back-link" href={blogUrl}>{t(locale, 'blog.back')}</a>
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate, locale, 'long')}</time>
        {post.data.translationPending && <span class="pending-note">Not yet available in Spanish</span>}
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body anim-rise delay-1">
      <Content />
    </div>
    <div class="post-end">
      <a class="btn btn-surface" href={blogUrl}>{t(locale, 'blog.backBottom')}</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    margin-bottom: clamp(24px, 3vw, 38px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    font-size: 14px;
    color: var(--muted);
  }

  .pending-note {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 12px;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 4.6vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .post-body {
    margin-top: clamp(28px, 3.5vw, 45px);
    padding-top: clamp(28px, 3.5vw, 45px);
    border-top: 1px solid var(--line);
    font-size: clamp(17px, 1.45vw, 19px);
    line-height: 1.75;
    color: var(--body);
  }

  .post-body :global(p) {
    margin: 0 0 1.2em;
    text-wrap: pretty;
  }

  .post-body :global(> p:first-child) {
    font-size: 1.15em;
    color: var(--ink);
  }

  .post-body :global(a) {
    color: var(--blue-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 1.5em;
    line-height: 1.2;
  }

  .post-body :global(blockquote) {
    margin: 1.6em 0;
    padding: 0;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 1.4em;
    line-height: 1.35;
    color: var(--blue-ink);
    text-wrap: balance;
  }

  .post-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .post-body :global(figure) {
    margin: 1.6em 0;
  }

  .post-body :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .post-end {
    display: flex;
    justify-content: center;
    margin-top: clamp(32px, 4vw, 51px);
  }

  .post-end .btn {
    padding: 14px 26px;
  }
</style>
