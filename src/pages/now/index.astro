---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import NowTimeline from '../../components/NowTimeline.astro';
import { t } from '../../i18n/ui';

const entries = await getCollection('now', ({ id }) => id.startsWith('en/'));
---

<BaseLayout title="Now — David Cadavid">
  <NowTimeline entries={entries} locale="en">
    <PageTitle text={t('en', 'nav.now')} />
  </NowTimeline>
</BaseLayout>
