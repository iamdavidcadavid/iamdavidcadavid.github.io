---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import { t, plural } from '../../i18n/ui';

export async function getStaticPaths() {
  const albums = await getCollection('albums', ({ id }) => id.startsWith('en/'));
  return albums.map((album) => ({
    params: { album: album.id.split('/').slice(1).join('/') },
    props: { album },
  }));
}

const locale = 'en';
const { album } = Astro.props;
const count = album.data.photos.length;
---

<BaseLayout title={`${album.data.title} — David Cadavid`}>
  <PageTitle
    text={album.data.title}
    size="md"
    meta={count > 0 ? plural(locale, 'photos.count', count) : undefined}
    back={{ href: getRelativeLocaleUrl(locale, '/photos/'), label: t(locale, 'photos.back') }}
  />
  <PhotoLightbox photos={album.data.photos} locale={locale} />
</BaseLayout>
